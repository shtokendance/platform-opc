# ==============================================================================
# Platform-OPC 生产环境专用环境变量配置模板
# 实际部署时复制并重命名为：platform-opc.env
# 注意：本文件包含生产敏感秘钥与数据库口令，严禁提交至公共 Git 仓库！
# ==============================================================================

TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# 1. 企业微信接入配置（企微管理后台自建应用与通讯录凭证）
# ------------------------------------------------------------------------------
# 企微自建应用 Secret（用于扫码/免登认证）
WECOM_SECRET=your_wecom_app_secret_here
# 企微通讯录管理 Secret（用于同步组织架构部门树与人员信息）
WECOM_CONTACT_SECRET=your_wecom_contact_secret_here
# 企微回调 Token
WECOM_TOKEN=your_callback_token_here
# 企微回调消息加密 EncodingAESKey
WECOM_ENCODING_AES_KEY=your_43_char_encoding_aes_key_here

# ------------------------------------------------------------------------------
# 2. 平台核心安全秘钥（生产必须使用 openssl rand -hex 32 随机生成，不得沿用测试值）
# ------------------------------------------------------------------------------
# WeKnora 敏感数据加解密秘钥（必须为 32 字节 Hex 字符串，对应 64 位字符）
SYSTEM_AES_KEY=change_me_32_bytes_hex_aes_key_64_chars_total

# 管理后台 (/admin/*) 专属 HS256 JWT 秘钥（启动强制校验）
PLATFORM_ADMIN_KEY=change_me_production_platform_admin_jwt_secret_key

# 平台自有用户身份与会话 (/integration/v1) HS256 JWT 秘钥（启动强制校验）
PLATFORM_AUTH_KEY=change_me_production_platform_auth_jwt_secret_key

# 知识库桥接适配 (/kbridge) 个人凭证签名秘钥（需与 WeKnora app 容器的 JWT_SECRET 严格一致）
PLATFORM_BRIDGE_KEY=change_me_match_weknora_app_jwt_secret
WEKNORA_JWT_SECRET=change_me_match_weknora_app_jwt_secret

# ------------------------------------------------------------------------------
# 3. 生产数据库凭证（PostgreSQL）
# ------------------------------------------------------------------------------
# WeKnora 主数据库连接密码（主库名与主机在 config.yaml 中配置）
DB_PASSWORD=your_production_postgres_password_here

# 平台自有状态库专属账号密码（存储审计日志、用户映射、同步账本）
STATE_DB_USER=opc_platform
STATE_DB_PASSWORD=your_state_db_strong_password_here
STATE_DB_NAME=weknora_gateway_state

# ------------------------------------------------------------------------------
# 4. 对外域名与内部微服务调用鉴权
# ------------------------------------------------------------------------------
# 平台对外规范 HTTPS 地址（企微回调跳转与客户端 OAuth 唯一事实源，末尾不要斜杠）
EXTERNAL_BASE_URL=https://opc.yourcompany.com

# 平台内部微服务间通信共享认证 Token
PLATFORM_SERVICE_TOKEN=change_me_random_long_service_token

# OPC Code 后端通讯（代码/沙箱权限联动通道）
CODE_BASE_URL=http://opc-code:8080
CODE_SERVICE_TOKEN=change_me_random_long_service_token

# WeKnora OIDC 互联凭据
OIDC_CLIENT_ID=weknora
OIDC_CLIENT_SECRET=change_me_production_oidc_secret

# ------------------------------------------------------------------------------
# 5. 生产对象存储（MinIO / S3 兼容协议，用于应用构建制品与知识库归档存储）
# ------------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET_NAME=weknora
MINIO_ACCESS_KEY_ID=your_minio_access_key_here
MINIO_SECRET_ACCESS_KEY=your_minio_secret_key_here
MINIO_USE_SSL=false
MINIO_PATH_PREFIX=weknora/

# ------------------------------------------------------------------------------
# 6. 知识库向量数据库（Milvus）
# ------------------------------------------------------------------------------
MILVUS_ADDRESS=milvus:19530
MILVUS_COLLECTION=weknora_embeddings
MILVUS_METRIC_TYPE=IP
